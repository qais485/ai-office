# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=ai_office
POSTGRES_PORT=5432

# Application
ENVIRONMENT=production
SECRET_KEY=CHANGE_ME_GENERATE_WITH: python -c "import secrets; print(secrets.token_urlsafe(64))"
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# Frontend
FRONTEND_URL=http://localhost:80
FRONTEND_PORT=80
BACKEND_PORT=8000

# CORS (JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:80","http://localhost:3000"]

# LLM
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=400
LLM_SKIP_AUTOMATED_SENDERS=true
LLM_EMAIL_BODY_MAX_CHARS=1000
MIN_SCHEDULED_INTERVAL_SECONDS=300

# Embeddings (defaults to LLM_API_KEY if not set)
EMBEDDING_API_KEY=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth2/callback

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
