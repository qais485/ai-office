# Environment
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_office

# Security (generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
SECRET_KEY=
ENCRYPTION_KEY=

# Google OAuth (get from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/oauth2/callback

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Embeddings (defaults to LLM_API_KEY if not set)
EMBEDDING_API_KEY=

# Frontend URL
FRONTEND_URL=http://localhost:5173

# CORS (JSON array, auto-includes FRONTEND_URL)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
