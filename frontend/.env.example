# Backend API base URL.
# Leave unset (or empty) for same-origin mode: requests go to "/api/v1" —
# the Vite dev proxy (vite.config.ts) / nginx (nginx.conf) forwards them to the backend.
# Set it to an absolute URL when the backend is deployed separately, e.g.:
# VITE_API_URL=https://your-backend.example.com/api/v1
# (the backend must then allow this frontend's origin via FRONTEND_URL in its own .env)
#VITE_API_URL=

# Backend origin for the Vite dev proxy in same-origin mode (development only).
# Only needed when VITE_API_URL is unset; when VITE_API_URL is an absolute URL
# the proxy derives its target from it automatically. Example:
# VITE_API_PROXY_TARGET=http://localhost:8000
#VITE_API_PROXY_TARGET=

VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
